# Configure in secure local/provider settings. Never commit real values.
# Public project identifier/key. These do not replace database access policies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact HTTPS origin of this deployment; no path or trailing query.
NAM_APP_ORIGIN=
NAM_WORKSPACE_ID=
# Generate an independent random secret of at least 32 characters.
NAM_CSRF_SECRET=
# Server-only: account administration and private-file attestation.
SUPABASE_SERVICE_ROLE_KEY=
# Explicit workspace binding before any provider work is allowed.
NAM_INTEGRATIONS_WORKSPACE_ID=
ATTIO_API_KEY=
ATTIO_DEALS_OBJECT=
LEMLIST_API_KEY=
JUSTCALL_API_KEY=
JUSTCALL_API_SECRET=
# Jobs can also use the provider's modern server-only secret-key variable.
SUPABASE_SECRET_KEY=
NAM_CRON_SECRET=
# For Vercel Cron, set CRON_SECRET to the same private value as NAM_CRON_SECRET.
# Do not add an active schedule before authentication and staging tests pass.
